{
  "name": "caresmile-dental-landing-page",
  "version": "0.1.0",
  "private": true,
  "description": "A modern, fully responsive dental care landing page built with React.js and Tailwind CSS, featuring a clean UI, patient-focused design, and seamless user experience.",
  "author": "moizycodes",
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-scripts": "5.0.1",
    "swiper": "^14.3.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "npm run build:css && react-scripts build",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./src/output.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./src/output.css --watch",
    "dev": "npm run watch:css",
    "test": "react-scripts test",
    "test:ci": "CI=true react-scripts test --watchAll=false",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
